              "app_id",
              "role_name",
              "status",
              "created_at"
            ],
            "properties": {
              "created_at": {
                "type": "string"
              },
              "request_id": {
                "type": "string"
              },
              "role_name": {
                "type": "string"
              },
              "status": {
                "type": "string"
              },
              "approver_id": {
                "type": [
