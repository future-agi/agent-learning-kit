[
  {
    "name": "search_files",
    "description": "Search for Drive files using a structured query (syntax: `query_term operator values`). Clauses are joined with `and`; string values are single-quoted. Terms: title (contains, =, !=), fullText (contains), mimeType (contains, =, !=), parentId (=, !=), owner (=, !=; 'me' is the requesting user). Use nextPageToken to paginate.",
    "parameters": {
      "type": "object",
      "properties": {
        "query": {
          "type": "string",
          "description": "The search query."
        },
        "pageToken": {
          "type": "string",
          "description": "The page token to use for pagination."
        },
        "pageSize": {
          "type": "integer",
          "description": "The maximum number of files to return in each page."
        },
        "excludeContentSnippets": {
          "type": "boolean",
          "description": "If true, the content snippet will be excluded from the response."
        }
      },
      "required": [
        "query"
      ]
    },
    "mutates_state": false,
    "returns": {
      "type": "object",
      "properties": {
        "files": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "title": {
                "type": "string"
              },
              "parentId": {
                "type": "string"
              },
              "mimeType": {
                "type": "string"
              },
              "fileSize": {
                "type": "string"
              },
              "description": {
                "type": "string"
              },
              "fileExtension": {
                "type": "string"
              },
              "contentSnippet": {
                "type": "string"
              },
              "viewUrl": {
                "type": "string"
              },
              "createdTime": {
                "type": "string"
              },
              "modifiedTime": {
                "type": "string"
              },
              "owner": {
                "type": "string"
              },
              "canAddChildren": {
                "type": "boolean"
              }
            },
            "required": [
              "id",
              "title",
              "parentId",
              "mimeType",
              "fileSize",
              "description",
              "viewUrl",
              "createdTime",
              "modifiedTime",
              "owner",
              "canAddChildren"
            ]
          }
        },
        "nextPageToken": {
          "type": "string"
        }
      },
      "required": [
        "files"
      ]
    }
  },
  {
