[
  {
    "name": "search_files",
    "description": "Search accessible Google Drive policy files by keyword query and optional folder filter with pagination.",
    "parameters": {
      "properties": {
        "query": {
          "type": "string"
        },
        "page_token": {
          "type": "string"
        },
        "folder_id": {
          "type": "string"
        },
        "page_size": {
          "type": "integer"
        }
      },
      "type": "object",
      "required": [
        "query"
      ]
    },
    "mutates_state": false,
    "returns": {
      "type": "object",
      "properties": {
        "files": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "next_page_token": {
          "type": "string"
        },
        "total_results": {
          "type": "integer"
        }
      },
      "required": [
        "files",
        "total_results"
      ]
    }
  },
  {
    "name": "list_recent_files",
    "description": "List recently modified accessible files in Google Drive within a folder, with pagination.",
    "parameters": {
      "required": [
        "folder_id"
      ],
      "properties": {
        "folder_id": {
          "type": "string"
        },
        "page_size": {
          "type": "integer"
        },
        "page_token": {
          "type": "string"
        }
      },
      "type": "object"
    },
    "mutates_state": false,
    "returns": {
      "required": [
        "files",
        "total_results"
      ],
      "type": "object",
      "properties": {
        "files": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "next_page_token": {
          "type": "string"
        },
        "total_results": {
          "type": "integer"
        }
      }
    }
  },
  {
