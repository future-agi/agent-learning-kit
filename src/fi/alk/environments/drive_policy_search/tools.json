  {
    "name": "get_file_permissions",
    "description": "List the permissions of a Drive file (its own and its folder's).",
    "parameters": {
      "type": "object",
      "properties": {
        "fileId": {
          "type": "string",
          "description": "The ID of the file to get permissions for."
