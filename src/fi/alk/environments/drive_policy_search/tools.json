          "type": "string"
        }
      },
      "type": "object"
    }
  },
  {
    "name": "get_file_permissions",
    "description": "Get access control list (ACL) and permissions for a Google Drive file and its parent folder. Enforces ACL check on caller.",
    "parameters": {
      "properties": {
        "file_id": {
          "type": "string"
        }
      },
      "required": [
        "file_id"
      ],
      "type": "object"
    },
    "mutates_state": false,
    "returns": {
      "properties": {
        "owner_id": {
          "type": "string"
        },
        "permissions": {
          "items": {
            "type": "object"
          },
          "type": "array"
        },
        "file_id": {
          "type": "string"
        },
        "folder_id": {
          "type": "string"
        }
      },
      "required": [
        "file_id",
        "permissions"
      ],
      "type": "object"
    }
  },
  {
    "name": "read_file_content",
    "description": "Read the text content of a Google Drive document or specific revision. Enforces ACLs, version metadata, and refuses binary or deleted files.",
