          "type": "string"
        },
        "employee_id": {
          "type": "string"
        },
        "working_days": {
          "type": "number"
        },
        "reason": {
          "type": "string"
        },
        "leave_type": {
          "type": "string"
        },
        "reserved_days": {
          "type": "number"
        },
        "status": {
          "type": "string"
        },
        "end_date": {
          "type": "string"
        },
        "approver_id": {
          "type": "string"
        },
        "request_id": {
          "type": "string"
        }
      },
      "required": [
        "request_id",
        "employee_id",
        "leave_type",
        "start_date",
        "end_date",
        "working_days",
        "status",
        "approver_id"
      ],
      "type": "object"
    }
  },
