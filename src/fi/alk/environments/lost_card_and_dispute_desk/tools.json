          "type": "string"
        }
      }
    }
  },
  {
    "name": "create_handoff",
    "description": "Create a specialist escalation or support handoff when automation is blocked or verification fails.",
    "parameters": {
      "type": "object",
      "properties": {
        "department": {
          "enum": [
            "fraud_specialist",
            "customer_support",
            "card_services"
          ],
          "description": "Target department for the transfer",
          "type": "string"
        },
        "context": {
          "type": "string",
          "description": "Context or notes explaining the handoff reason"
        },
        "reason": {
          "type": "string",
          "enum": [
            "verification_failed",
            "service_error",
            "complex_dispute",
            "customer_requested_agent",
            "unrecognized_card"
          ],
          "description": "The reason triggering the escalation or handoff"
        },
        "transaction_id": {
          "type": "string",
          "description": "Optional transaction identifier related to the handoff"
        },
        "card_id": {
          "description": "Optional card identifier related to the handoff",
          "type": "string"
        },
        "customer_id": {
          "type": "string",
          "description": "The unique customer identifier, e.g. C01"
        },
        "session_id": {
          "type": "string",
          "description": "The active session identifier, e.g. SESS01"
        }
      },
      "required": [
        "customer_id",
        "session_id",
        "reason"
      ]
    },
    "mutates_state": true,
    "returns": {
      "required": [
        "handoff_id",
        "customer_id",
        "session_id",
        "department",
        "reason",
        "status",
        "created_at"
      ],
      "type": "object",
      "properties": {
        "card_id": {
          "type": "string"
        },
        "reason": {
          "type": "string"
        },
        "created_at": {
          "type": "string"
        },
        "handoff_id": {
          "type": "string"
        },
        "context": {
          "type": "string"
        },
        "customer_id": {
          "type": "string"
        },
        "status": {
          "type": "string"
        },
        "department": {
          "type": "string"
        },
        "session_id": {
          "type": "string"
        },
        "transaction_id": {
          "type": "string"
        }
      }
    }
  }
