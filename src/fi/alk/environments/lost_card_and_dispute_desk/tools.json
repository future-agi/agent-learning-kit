      ],
      "properties": {
        "session_id": {
          "description": "The active session identifier, e.g. SESS01",
          "type": "string"
        },
        "transaction_id": {
          "description": "The transaction identifier to look up dispute for",
          "type": "string"
        },
        "customer_id": {
          "description": "The unique customer identifier, e.g. C01",
          "type": "string"
        },
        "dispute_id": {
          "description": "The dispute identifier to look up, e.g. D01",
          "type": "string"
        }
      }
    },
    "mutates_state": false,
    "returns": {
      "type": "object",
      "required": [
        "dispute_id",
        "transaction_id",
        "customer_id",
        "amount",
        "currency",
        "dispute_reason",
        "status",
        "created_at",
        "updated_at"
      ],
      "properties": {
        "customer_id": {
          "type": "string"
        },
        "amount": {
          "type": "integer"
        },
        "currency": {
          "type": "string"
        },
        "status": {
          "type": "string"
        },
        "dispute_reason": {
          "type": "string"
        },
        "created_at": {
          "type": "string"
        },
        "transaction_id": {
          "type": "string"
        },
        "notes": {
          "type": "string"
        },
        "dispute_id": {
          "type": "string"
        },
