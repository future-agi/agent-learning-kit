  {
    "name": "search_documents",
    "description": "Search the corpus the employee may read, by words in titles and passages; returns documents by Drive file id with version, status, whether in effect, and matching passage ids. Approved versions only unless include_superseded is true.",
    "parameters": {
      "type": "object",
      "required": [
        "employee_id",
        "query"
      ],
      "properties": {
        "employee_id": {
          "type": "string",
          "description": "The employee asking, e.g. E01"
        },
        "query": {
          "type": "string",
          "description": "Words to look for"
        },
        "collection_id": {
          "type": "string",
          "description": "Only this collection, e.g. C_TRAVEL"
        },
        "include_superseded": {
          "type": "boolean",
          "description": "Also return superseded and draft versions"
        }
      }
    },
    "mutates_state": false,
    "returns": {
      "type": "object",
      "required": [
        "results",
        "count"
      ],
      "properties": {
        "results": {
          "type": "array"
        },
        "count": {
          "type": "integer"
        }
      }
    }
  },
