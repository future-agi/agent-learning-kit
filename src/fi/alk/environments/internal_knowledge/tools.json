  {
    "name": "read_file_content",
    "description": "Fetch a natural language representation of a Drive file, and optionally its comments. fileId must come from search_files or list_recent_files. An unsupported format returns textFormattingNotSupported=true with empty fileContent. revisionId reads an earlier revision of the file.",
    "parameters": {
      "type": "object",
      "properties": {
        "fileId": {
          "type": "string",
          "description": "The ID of the file to retrieve."
        },
        "includeComments": {
          "type": "boolean",
          "description": "Whether to include comments in the response."
        },
        "revisionId": {
          "type": "string",
          "description": "An earlier revision of the file to read instead of the current content."
        }
      },
      "required": [
        "fileId"
      ]
    },
    "mutates_state": false,
    "returns": {
      "type": "object",
      "properties": {
        "fileContent": {
          "type": "string"
        },
        "textFormattingNotSupported": {
          "type": "boolean"
        },
        "contentAnchoredComments": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "unanchoredComments": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "commentsNotSupported": {
          "type": "boolean"
        },
        "revisionId": {
