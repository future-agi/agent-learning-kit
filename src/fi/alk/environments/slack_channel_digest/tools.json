[
  {
    "name": "slack_search_channels",
    "description": "Search for Slack channels by name or topic. Returns channel IDs, names, topics, privacy and membership. Private channels appear only to their members.",
    "parameters": {
      "type": "object",
      "properties": {
        "keywords": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Lexical terms that must appear in the channel's name or topic; single words or quoted phrases, all AND'd."
        },
        "natural_language_query": {
          "type": "string",
          "description": "The user's question in conversational tone."
        },
        "channel_types": {
          "type": "string",
          "description": "Comma-separated: public_channel, private_channel. Default public_channel."
        },
        "cursor": {
          "type": "string"
        },
        "include_archived": {
          "type": "boolean"
        },
        "limit": {
          "type": "integer",
          "description": "Up to 20; default 20."
        },
        "response_format": {
          "type": "string"
        }
      }
    },
    "mutates_state": false,
    "returns": {
      "type": "object",
      "properties": {
        "channels": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "channel_id": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "topic": {
                "type": "string"
              },
              "purpose": {
                "type": "string"
              },
              "is_private": {
                "type": "boolean"
              },
              "is_member": {
                "type": "boolean"
              },
              "member_count": {
                "type": "integer"
              },
              "is_archived": {
                "type": "boolean"
              }
            },
            "required": [
              "channel_id",
              "name",
              "is_private",
              "is_member"
            ]
          }
        },
        "next_cursor": {
          "type": "string"
        }
      },
      "required": [
        "channels"
      ]
    }
  },
  {
    "name": "slack_read_channel",
    "description": "Reads messages from a channel, newest first. Read-only. Use slack_read_thread with a message's ts to read its replies; use slack_search_channels to find a channel ID.",
    "parameters": {
      "type": "object",
      "properties": {
        "channel_id": {
          "type": "string",
          "description": "ID of the channel to fetch history for."
        },
        "cursor": {
          "type": "string",
          "description": "next_cursor from a previous response."
        },
        "latest": {
          "type": "string",
          "description": "End of the time range (ts)."
        },
        "limit": {
          "type": "integer",
          "description": "1 to 100; default 100."
        },
        "oldest": {
          "type": "string",
          "description": "Start of the time range (ts)."
        },
        "response_format": {
          "type": "string"
        }
      },
      "required": [
        "channel_id"
      ]
    },
    "mutates_state": false,
    "returns": {
      "type": "object",
      "properties": {
        "channel_id": {
          "type": "string"
        },
        "messages": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "message_id": {
                "type": "string"
              },
              "user_id": {
                "type": "string"
              },
              "text": {
                "type": "string"
              },
              "ts": {
                "type": "string"
              },
              "thread_ts": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "permalink": {
                "type": "string"
              }
            },
            "required": [
              "message_id",
              "user_id",
              "text",
              "ts",
              "permalink"
            ]
          }
        },
        "has_more": {
          "type": "boolean"
        },
        "next_cursor": {
          "type": "string"
        }
      },
      "required": [
        "channel_id",
        "messages",
        "has_more"
      ]
    }
  },
  {
    "name": "slack_read_thread",
    "description": "Reads a thread: the parent message and its replies, oldest first. Read-only. message_ts is the parent message's ts.",
    "parameters": {
      "type": "object",
      "properties": {
        "channel_id": {
          "type": "string",
          "description": "Channel the thread is in."
        },
        "message_ts": {
          "type": "string",
          "description": "Timestamp of the parent message, e.g. \"1234567890.123456\"."
        },
        "cursor": {
          "type": "string"
        },
        "latest": {
          "type": "string"
        },
        "limit": {
          "type": "integer",
          "description": "1 to 1000; default 100."
        },
        "oldest": {
          "type": "string"
        },
        "response_format": {
          "type": "string"
        }
      },
      "required": [
        "channel_id",
        "message_ts"
      ]
    },
    "mutates_state": false,
    "returns": {
      "type": "object",
      "properties": {
        "channel_id": {
          "type": "string"
        },
        "message_ts": {
          "type": "string"
        },
        "messages": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "message_id": {
                "type": "string"
              },
              "user_id": {
                "type": "string"
              },
              "text": {
                "type": "string"
              },
              "ts": {
                "type": "string"
              },
              "thread_ts": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "permalink": {
                "type": "string"
              }
            },
            "required": [
              "message_id",
              "user_id",
              "text",
              "ts",
              "permalink"
            ]
          }
        },
        "has_more": {
          "type": "boolean"
        },
        "next_cursor": {
          "type": "string"
        }
      },
      "required": [
        "channel_id",
        "message_ts",
        "messages",
        "has_more"
      ]
    }
  },
  {
    "name": "slack_search_public_and_private",
    "description": "Searches messages in all channels the acting user can access. keywords are lexical terms (all AND'd); filters are Slack search modifiers: in:<#C123>, from:<@U123>, after:YYYY-MM-DD, before:YYYY-MM-DD. Give at least one of keywords or filters.",
    "parameters": {
      "type": "object",
      "properties": {
        "keywords": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "filters": {
          "type": "string"
        },
        "natural_language_query": {
          "type": "string"
        },
        "after": {
          "type": "string",
          "description": "Only messages after this Unix timestamp."
        },
        "before": {
          "type": "string",
          "description": "Only messages before this Unix timestamp."
        },
        "channel_types": {
          "type": "string"
        },
        "content_types": {
          "type": "string"
        },
        "context_channel_id": {
          "type": "string"
        },
        "cursor": {
          "type": "string"
        },
        "include_bots": {
          "type": "boolean"
        },
        "include_context": {
          "type": "boolean"
        },
        "limit": {
          "type": "integer",
          "description": "Up to 20; default 20."
        },
        "max_context_length": {
          "type": "integer"
        },
        "only_my_channels": {
          "type": "boolean"
        },
        "response_format": {
          "type": "string"
        },
        "sort": {
          "type": "string",
          "description": "score (default) or timestamp."
        },
        "sort_dir": {
          "type": "string",
          "description": "asc or desc (default)."
        }
      }
    },
    "mutates_state": false,
    "returns": {
      "type": "object",
      "properties": {
        "messages": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "message_id": {
                "type": "string"
              },
              "user_id": {
                "type": "string"
              },
              "text": {
                "type": "string"
              },
              "ts": {
                "type": "string"
              },
              "thread_ts": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "permalink": {
                "type": "string"
              },
              "channel_id": {
                "type": "string"
              },
              "channel_name": {
                "type": "string"
              }
            },
            "required": [
              "message_id",
              "channel_id",
              "user_id",
              "text",
              "ts",
              "permalink"
            ]
          }
        },
        "has_more": {
          "type": "boolean"
        },
        "next_cursor": {
          "type": "string"
        }
      },
      "required": [
        "messages",
        "has_more"
      ]
    }
  },
  {
    "name": "slack_send_message",
    "description": "Sends a message to a channel, or a thread reply with thread_ts. Posting is approval-gated: approval_id must name an approval of this exact destination and text for the acting user. request_key makes a retry return the message already posted instead of a duplicate. No @channel, @here or @everyone.",
    "parameters": {
      "type": "object",
      "properties": {
        "channel_id": {
          "type": "string",
          "description": "Destination channel ID."
        },
        "message": {
          "type": "string",
          "description": "The message text (markdown)."
        },
        "thread_ts": {
          "type": "string",
          "description": "Parent message ts to reply in its thread."
        },
        "reply_broadcast": {
          "type": "boolean"
        },
        "unfurl_app_links": {
          "type": "boolean"
        },
        "draft_id": {
          "type": "string"
        },
        "approval_id": {
          "type": "string",
          "description": "The approval authorizing this post."
        },
        "request_key": {
          "type": "string",
          "description": "Idempotency key for this request."
        }
      },
      "required": [
        "channel_id",
        "message"
      ]
    },
    "mutates_state": true,
    "returns": {
      "type": "object",
      "properties": {
        "channel_id": {
          "type": "string"
        },
        "ts": {
          "type": "string"
        },
        "message_id": {
          "type": "string"
        },
        "permalink": {
          "type": "string"
        },
        "status": {
          "type": "string"
        },
        "request_key": {
          "type": "string"
        },
        "thread_ts": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "channel_id",
        "ts",
        "message_id",
        "permalink",
        "status"
      ]
    }
  },
  {
    "name": "slack_check_message_status",
    "description": "Check delivery status and idempotency ledger record for a given request_key.",
    "parameters": {
      "required": [
        "request_key"
      ],
      "type": "object",
      "properties": {
        "request_key": {
          "type": "string",
          "description": "The idempotency request key to inspect."
        }
      }
    },
    "mutates_state": false,
    "returns": {
      "type": "object",
      "properties": {
        "channel_id": {
          "type": "string"
        },
        "text": {
          "type": "string"
        },
        "created_at": {
          "type": "string"
        },
        "permalink": {
          "type": "string"
        },
        "thread_ts": {
          "type": "string"
        },
        "message_id": {
          "type": "string"
        },
        "request_key": {
          "type": "string"
        },
        "status": {
          "type": "string"
        }
      },
      "required": [
        "channel_id",
        "created_at",
        "message_id",
        "permalink",
        "request_key",
        "status",
        "text"
      ]
    }
  }
]
