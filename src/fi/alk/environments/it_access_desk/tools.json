  {
    "name": "get_app_catalog",
    "description": "Retrieve application catalog, descriptions, owners, and available roles for an application or 'ALL'.",
    "parameters": {
      "required": [
        "app_id"
      ],
      "type": "object",
      "properties": {
        "category": {
          "description": "Optional category filter (e.g. 'Analytics')",
          "type": "string"
        },
        "app_id": {
          "type": "string",
          "description": "Application ID (e.g. 'APP-RPT') or 'ALL' to view all applications"
        }
      }
    },
    "mutates_state": false,
    "returns": {
      "properties": {
        "count": {
          "type": "integer"
        },
        "applications": {
          "type": "array",
          "items": {
            "required": [
              "app_id",
              "name",
              "description",
              "owner_id",
              "category",
              "roles"
            ],
            "properties": {
              "category": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "roles": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "role_id",
                    "role_name",
                    "tier",
                    "description",
                    "requires_approval"
                  ],
                  "properties": {
                    "role_name": {
                      "type": "string"
                    },
                    "tier": {
                      "type": "string"
                    },
                    "role_id": {
                      "type": "string"
                    },
                    "requires_approval": {
                      "type": "string"
                    },
                    "description": {
                      "type": "string"
                    }
                  }
                }
              },
              "description": {
                "type": "string"
              },
              "owner_id": {
                "type": "string"
              },
              "app_id": {
                "type": "string"
              }
            },
            "type": "object"
          }
        }
      },
      "type": "object",
      "required": [
        "applications",
        "count"
      ]
    }
  },
  {
    "name": "get_current_access",
    "description": "Retrieve active entitlements and pending access requests for an employee.",
    "parameters": {
      "type": "object",
      "properties": {
        "app_id": {
          "description": "Optional application ID (e.g. 'APP-CRM')",
          "type": "string"
        },
        "employee_id": {
          "type": "string",
          "description": "Employee ID (e.g. 'E01')"
        }
      },
      "required": [
        "employee_id"
      ]
    },
    "mutates_state": false,
    "returns": {
      "properties": {
        "active_entitlements": {
          "type": "array",
          "items": {
            "required": [
              "entitlement_id",
              "app_id",
              "role_name",
              "status",
              "granted_at",
              "granted_by"
            ],
            "type": "object",
            "properties": {
              "granted_at": {
                "type": "string"
              },
              "app_id": {
                "type": "string"
              },
              "entitlement_id": {
                "type": "string"
              },
              "status": {
                "type": "string"
              },
              "expires_at": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "role_name": {
                "type": "string"
              },
              "granted_by": {
                "type": "string"
              }
            }
          }
        },
        "pending_requests": {
          "items": {
            "type": "object",
            "required": [
              "request_id",
              "app_id",
              "role_name",
              "status",
              "created_at"
            ],
            "properties": {
              "created_at": {
                "type": "string"
              },
              "request_id": {
                "type": "string"
              },
              "role_name": {
                "type": "string"
              },
              "status": {
                "type": "string"
              },
              "approver_id": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "app_id": {
                "type": "string"
              }
            }
          },
          "type": "array"
        },
        "employee_id": {
          "type": "string"
        }
      },
      "type": "object",
      "required": [
        "employee_id",
        "active_entitlements",
        "pending_requests"
      ]
    }
  },
  {
