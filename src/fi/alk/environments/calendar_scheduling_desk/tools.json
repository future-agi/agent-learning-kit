          "description": "ID of the calendar to fetch events from.",
          "type": "string"
        },
        "time_min": {
          "type": "string",
          "description": "Lower bound (inclusive/exclusive boundary ISO-8601 string) for event filtering."
        },
        "max_results": {
          "description": "Maximum number of events to return (default: 50).",
          "type": "integer"
        },
        "page_token": {
