              "id": {
                "type": "string"
              },
              "summary": {
                "type": "string"
              },
              "description": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "timeZone": {
                "type": "string"
              },
              "accessRole": {
                "type": "string"
              }
            },
            "required": [
              "id",
              "summary",
              "timeZone",
              "accessRole"
            ]
          }
        },
        "nextPageToken": {
          "type": "string"
        }
      },
      "required": [
        "calendars"
      ]
    }
  },
  {
    "name": "list_events",
