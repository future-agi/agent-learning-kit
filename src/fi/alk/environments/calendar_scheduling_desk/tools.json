          "description": "Calendar ID from list_calendars. Default: the primary calendar."
        },
        "notificationLevel": {
          "type": "string"
        },
        "approval_id": {
          "type": "string",
          "description": "The approval authorizing this change; required while the environment requires approval for mutations."
        },
