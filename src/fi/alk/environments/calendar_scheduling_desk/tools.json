  {
    "name": "suggest_time",
    "description": "Suggest candidate meeting slots considering attendee schedules, working hours, and buffer times.",
    "parameters": {
      "type": "object",
      "required": [
        "attendees",
        "duration_minutes",
        "time_min",
        "time_max"
      ],
      "properties": {
        "time_zone": {
          "type": "string",
          "description": "Preferred output timezone string (e.g. UTC, America/New_York)."
        },
        "time_max": {
          "description": "End of search window in ISO-8601 format.",
          "type": "string"
        },
        "duration_minutes": {
          "type": "integer",
          "description": "Meeting duration in minutes."
        },
        "attendees": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "List of attendee email addresses to check overlapping availability for."
        },
        "time_min": {
          "description": "Start of search window in ISO-8601 format.",
          "type": "string"
        },
        "max_candidates": {
          "type": "integer",
          "description": "Maximum number of candidate slots to suggest (default: 5)."
        }
      }
    },
    "mutates_state": false,
    "returns": {
      "properties": {
        "searchWindow": {
          "properties": {
            "end": {
              "type": "string"
            },
            "start": {
              "type": "string"
            }
          },
          "type": "object"
        },
        "candidates": {
          "type": "array",
          "items": {
            "properties": {
              "start": {
                "type": "string"
              },
              "timeZone": {
                "type": "string"
              },
              "attendees": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "durationMinutes": {
                "type": "integer"
              },
              "end": {
                "type": "string"
              }
            },
            "type": "object"
          }
        },
        "bufferMinutesApplied": {
          "type": "integer"
        }
      },
      "type": "object",
      "required": [
        "candidates"
      ]
    }
  },
