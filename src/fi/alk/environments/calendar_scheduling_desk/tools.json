  {
    "name": "suggest_time",
    "description": "Suggests free time slots across the attendees' calendars within a query interval, respecting the configured buffer between events. A suggestion reserves nothing: create the event after the user confirms.",
    "parameters": {
      "type": "object",
      "properties": {
        "attendeeEmails": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Attendee emails to find free time for."
        },
        "startTime": {
          "type": "string",
          "description": "Query interval start (ISO 8601, for example '2026-04-30T10:00:00Z')."
        },
        "endTime": {
          "type": "string",
          "description": "Query interval end (ISO 8601, for example '2026-04-30T10:00:00Z')."
        },
        "timeZone": {
          "type": "string",
          "description": "IANA Time Zone Database name (for example America/Los_Angeles)."
        },
        "durationMinutes": {
          "type": "integer",
          "description": "Default 30."
        },
        "preferences": {
          "type": "object",
          "properties": {
            "startHour": {
              "type": "string",
              "description": "HH:mm, 24-hour."
            },
            "endHour": {
              "type": "string",
              "description": "HH:mm, 24-hour."
            },
            "excludeWeekends": {
              "type": "boolean"
            },
            "pageSize": {
              "type": "integer",
              "description": "Number of slots; default 5."
            }
          }
        }
      },
      "required": [
        "attendeeEmails",
        "startTime",
        "endTime"
      ]
    },
    "mutates_state": false,
    "returns": {
      "type": "object",
      "properties": {
        "timeSlots": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "start": {
                "type": "object",
                "properties": {
                  "dateTime": {
                    "type": "string"
                  },
                  "date": {
                    "type": "string"
                  },
                  "timeZone": {
                    "type": "string"
                  }
                }
              },
              "end": {
                "type": "object",
                "properties": {
                  "dateTime": {
                    "type": "string"
                  },
                  "date": {
                    "type": "string"
                  },
                  "timeZone": {
                    "type": "string"
                  }
                }
              }
            },
            "required": [
              "start",
              "end"
            ]
          }
        }
      },
      "required": [
        "timeSlots"
      ]
    }
  },
