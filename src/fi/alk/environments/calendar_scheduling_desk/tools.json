[
  {
    "name": "list_calendars",
    "description": "List Google Calendars accessible to the user with their timezone and access permissions.",
    "parameters": {
      "required": [
        "min_access_role"
      ],
      "type": "object",
      "properties": {
        "min_access_role": {
          "enum": [
            "reader",
            "writer",
            "owner"
          ],
          "description": "Filter calendars with at least this access level (reader, writer, owner).",
          "type": "string"
        }
      }
    },
    "mutates_state": false,
    "returns": {
      "required": [
        "calendars"
      ],
      "properties": {
        "calendars": {
          "items": {
            "properties": {
              "summary": {
                "type": "string"
              },
              "primary": {
                "type": "boolean"
              },
              "time_zone": {
                "type": "string"
              },
              "calendar_id": {
                "type": "string"
              },
              "access_role": {
                "type": "string"
              },
              "description": {
                "type": "string"
              }
            },
            "type": "object"
          },
          "type": "array"
        }
      },
      "type": "object"
    }
  },
