      "required": [
        "region",
        "topic",
        "effective_date",
        "policies"
      ],
      "type": "object",
      "properties": {
        "policies": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "policy_id",
              "region",
              "topic",
              "version",
              "effective_from",
              "effective_to",
              "title",
              "content",
              "carry_forward_days",
              "max_consecutive_days"
            ],
            "properties": {
              "region": {
                "type": "string"
              },
              "title": {
                "type": "string"
              },
              "content": {
                "type": "string"
              },
              "effective_from": {
                "type": "string"
              },
              "effective_to": {
                "type": "string"
              },
              "topic": {
                "type": "string"
              },
              "max_consecutive_days": {
                "type": "integer"
              },
              "policy_id": {
                "type": "string"
              },
              "carry_forward_days": {
                "type": "integer"
              },
              "version": {
                "type": "string"
              }
            }
          },
          "description": "Each policy in force, with source_file_id: the HR policy library document it mirrors"
        },
        "region": {
          "type": "string"
        },
        "effective_date": {
          "type": "string"
        },
        "topic": {
          "type": "string"
        }
      }
    }
  },
  {
    "name": "get_leave_balance",
    "description": "Retrieve current leave balance allocations, usage, reserved days, and available days for an employee.",
    "parameters": {
      "type": "object",
      "required": [
        "employee_id"
      ],
      "properties": {
        "actor_id": {
          "type": "string",
