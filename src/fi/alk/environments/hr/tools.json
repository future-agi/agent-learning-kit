        "balances": {
          "type": "array",
          "items": {
            "properties": {
              "allocated_days": {
                "type": "number"
              },
              "used_days": {
                "type": "number"
              },
              "leave_type": {
                "type": "string"
              },
              "available_days": {
                "type": "number"
              },
              "reserved_days": {
                "type": "number"
              }
            },
            "required": [
              "leave_type",
              "allocated_days",
              "used_days",
              "reserved_days",
              "available_days"
            ],
            "type": "object"
          }
        },
        "employee_id": {
          "type": "string"
        }
      }
    }
  },
  {
    "name": "calculate_working_days",
    "description": "Calculate net working days between two dates for a given region, excluding weekends and public holidays.",
    "parameters": {
      "required": [
        "start_date",
        "end_date",
        "region"
      ],
      "type": "object",
      "properties": {
        "start_date": {
          "description": "The start date (YYYY-MM-DD, inclusive)",
          "type": "string"
        },
        "region": {
          "description": "The geographic region (e.g. US, UK, APAC)",
          "type": "string"
        },
        "end_date": {
          "type": "string",
          "description": "The end date (YYYY-MM-DD, inclusive)"
        }
      }
    },
    "mutates_state": false,
    "returns": {
      "required": [
        "start_date",
        "end_date",
        "region",
        "total_calendar_days",
        "weekend_days",
        "holiday_days",
        "holidays_encountered",
        "working_days"
      ],
      "properties": {
        "start_date": {
          "type": "string"
        },
        "end_date": {
          "type": "string"
        },
        "weekend_days": {
          "type": "integer"
        },
        "working_days": {
          "type": "integer"
        },
        "total_calendar_days": {
          "type": "integer"
        },
        "holiday_days": {
          "type": "integer"
        },
        "region": {
          "type": "string"
        },
        "holidays_encountered": {
          "items": {
            "required": [
              "date",
              "name"
            ],
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              },
              "date": {
                "type": "string"
              }
            }
          },
          "type": "array"
        }
      },
      "type": "object"
    }
  },
