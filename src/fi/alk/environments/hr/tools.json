  {
    "name": "slack_search_channels",
    "description": "Search for Slack channels by name or topic. Returns channel IDs, names, topics, privacy and membership. Private channels appear only to their members.",
    "parameters": {
      "type": "object",
      "properties": {
        "keywords": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Lexical terms that must appear in the channel's name or topic; single words or quoted phrases, all AND'd."
        },
        "natural_language_query": {
          "type": "string",
          "description": "The user's question in conversational tone."
        },
        "channel_types": {
          "type": "string",
          "description": "Comma-separated: public_channel, private_channel. Default public_channel."
        },
        "cursor": {
          "type": "string"
        },
        "include_archived": {
          "type": "boolean"
        },
        "limit": {
          "type": "integer",
          "description": "Up to 20; default 20."
        },
        "response_format": {
          "type": "string"
        }
      }
    },
    "mutates_state": false,
    "returns": {
      "type": "object",
      "properties": {
        "channels": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "channel_id": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "topic": {
                "type": "string"
              },
              "purpose": {
                "type": "string"
              },
              "is_private": {
