  {
    "name": "search_threads",
    "description": "Search email threads in the mailbox matching a query string or label filters. Returns thread summaries with IDs, snippet, historyId, and labelIds.",
    "parameters": {
      "properties": {
        "page_token": {
          "description": "Pagination cursor token",
          "type": "string"
        },
        "label_ids": {
          "items": {
            "type": "string"
          },
          "description": "Optional list of label IDs to filter by",
          "type": "array"
        },
        "max_results": {
          "description": "Maximum number of threads to return (default 10)",
          "type": "integer"
        },
        "q": {
          "description": "Query string matching terms or label:LABEL_NAME",
          "type": "string"
        }
      },
      "type": "object"
    },
    "mutates_state": false,
    "returns": {
      "required": [
        "threads",
        "result_size_estimate"
      ],
      "type": "object",
      "properties": {
        "next_page_token": {
          "type": [
            "string",
            "null"
          ]
        },
        "threads": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "label_ids": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "snippet": {
                "type": "string"
              },
              "id": {
                "type": "string"
              },
              "history_id": {
                "type": "string"
              }
            },
            "required": [
              "id",
              "snippet",
              "history_id",
              "label_ids"
            ]
          }
        },
        "result_size_estimate": {
          "type": "integer"
        }
      }
    }
  },
