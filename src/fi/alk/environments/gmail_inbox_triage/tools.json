[
  {
    "name": "search_threads",
    "description": "Lists email threads matching a Gmail search query (label:ID, is:unread, in:inbox, from:, to:, subject:, newer_than:7d, free terms). Full message bodies are not returned; use get_thread for them. Drafts, spam and trash are excluded.",
    "parameters": {
      "type": "object",
      "properties": {
        "pageSize": {
          "type": "integer",
          "description": "Threads per page; default 20, maximum 50."
        },
        "pageToken": {
          "type": "string"
        },
        "query": {
          "type": "string",
          "description": "Gmail search syntax."
        },
        "includeTrash": {
          "type": "boolean",
          "description": "Include trashed threads (default false)."
        },
        "view": {
          "type": "string",
          "description": "THREAD_VIEW_UNSPECIFIED, THREAD_VIEW_METADATA_ONLY or THREAD_VIEW_MINIMAL (default)."
        }
      }
    },
    "mutates_state": false,
    "returns": {
      "type": "object",
      "properties": {
        "threads": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "messages": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string"
                    },
                    "snippet": {
                      "type": "string"
                    },
                    "subject": {
                      "type": "string"
                    },
                    "sender": {
                      "type": "string"
                    },
                    "toRecipients": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "ccRecipients": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "date": {
                      "type": "string"
                    },
                    "plaintextBody": {
                      "type": "string"
                    },
                    "htmlBody": {
                      "type": "string"
                    },
                    "attachmentIds": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "attachments": {
                      "type": "array",
                      "items": {
                        "type": "object"
                      }
                    },
                    "labelIds": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    }
                  },
                  "required": [
                    "id",
                    "snippet",
                    "subject",
                    "sender",
                    "toRecipients",
                    "date",
                    "labelIds"
                  ]
                }
              }
            },
            "required": [
              "id",
              "messages"
            ]
          }
        },
        "nextPageToken": {
          "type": "string"
        },
        "resultCountEstimate": {
          "type": "string"
        }
      },
      "required": [
        "threads",
        "resultCountEstimate"
      ]
    }
  },
  {
    "name": "get_thread",
    "description": "Retrieves an email thread by ID with its messages in date order (bodies under FULL_CONTENT).",
    "parameters": {
      "type": "object",
      "properties": {
        "threadId": {
          "type": "string",
          "description": "The unique identifier of the thread."
        },
        "messageFormat": {
          "type": "string",
          "description": "MESSAGE_FORMAT_UNSPECIFIED, MINIMAL, FULL_CONTENT (default; bodies included) or METADATA_ONLY."
        }
      },
      "required": [
        "threadId"
      ]
    },
    "mutates_state": false,
    "returns": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "messages": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "snippet": {
                "type": "string"
              },
              "subject": {
                "type": "string"
              },
              "sender": {
                "type": "string"
              },
              "toRecipients": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "ccRecipients": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "date": {
                "type": "string"
              },
              "plaintextBody": {
                "type": "string"
              },
              "htmlBody": {
                "type": "string"
              },
              "attachmentIds": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "attachments": {
                "type": "array",
                "items": {
                  "type": "object"
                }
              },
              "labelIds": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "required": [
              "id",
              "snippet",
              "subject",
              "sender",
              "toRecipients",
              "date",
              "labelIds"
            ]
          }
        }
      },
      "required": [
        "id",
        "messages"
      ]
    }
  },
  {
    "name": "get_message",
    "description": "Retrieves one email message by its message ID.",
