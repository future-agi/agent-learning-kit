          "type": "string"
        },
        "snippet": {
          "type": "string"
        },
        "subject": {
          "type": "string"
        },
        "sender": {
          "type": "string"
        },
        "toRecipients": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "ccRecipients": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "date": {
          "type": "string"
        },
        "plaintextBody": {
          "type": "string"
        },
        "htmlBody": {
          "type": "string"
        },
        "attachmentIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "attachments": {
