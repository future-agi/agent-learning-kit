  {
    "name": "list_labels",
    "description": "Lists the user-defined labels of the mailbox with their IDs. System label IDs (INBOX, UNREAD, STARRED, IMPORTANT, SENT, DRAFT, SPAM, TRASH) are usable without listing.",
    "parameters": {
      "type": "object",
      "properties": {
        "pageSize": {
          "type": "integer"
        },
        "pageToken": {
          "type": "string"
        }
      }
    },
    "mutates_state": false,
    "returns": {
      "type": "object",
      "properties": {
        "labels": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "labelId": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "threadsTotal": {
                "type": "integer"
              },
              "threadsUnread": {
                "type": "integer"
              }
            },
            "required": [
              "labelId",
              "name"
            ]
          }
        },
        "nextPageToken": {
          "type": "string"
        }
      },
      "required": [
        "labels"
      ]
    }
  },
  {
    "name": "label_thread",
    "description": "Adds labels to an entire thread (every message in it). Takes label IDs, not names; use list_labels when unsure of a user label's ID.",
    "parameters": {
      "type": "object",
      "properties": {
        "threadId": {
          "type": "string",
          "description": "The unique identifier of the thread."
        },
        "labelIds": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Label IDs (system IDs such as INBOX, UNREAD, IMPORTANT, or user label IDs from list_labels), never names."
        }
      },
      "required": [
        "threadId",
        "labelIds"
      ]
    },
    "mutates_state": true,
    "returns": {
      "type": "object",
      "properties": {}
    }
  },
  {
    "name": "unlabel_thread",
    "description": "Removes labels from an entire thread. Takes label IDs, not names.",
    "parameters": {
      "type": "object",
      "properties": {
        "threadId": {
          "type": "string",
          "description": "The unique identifier of the thread."
        },
        "labelIds": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Label IDs (system IDs such as INBOX, UNREAD, IMPORTANT, or user label IDs from list_labels), never names."
        }
      },
      "required": [
        "threadId",
        "labelIds"
      ]
    },
    "mutates_state": true,
    "returns": {
      "type": "object",
      "properties": {}
    }
  },
  {
    "name": "list_drafts",
    "description": "Lists the mailbox's drafts, newest first. humanEdited marks a draft a person has edited.",
    "parameters": {
      "type": "object",
      "properties": {
        "pageSize": {
          "type": "integer",
          "description": "Drafts per page; default 20, maximum 50."
        },
        "pageToken": {
          "type": "string"
        },
        "query": {
          "type": "string",
          "description": "Gmail search syntax."
        },
        "view": {
          "type": "string",
          "description": "DRAFT_VIEW_UNSPECIFIED, DRAFT_VIEW_METADATA_ONLY or DRAFT_VIEW_FULL (default)."
        }
      }
    },
    "mutates_state": false,
    "returns": {
      "type": "object",
      "properties": {
        "drafts": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "subject": {
                "type": "string"
              },
              "threadId": {
                "type": "string"
              },
              "toRecipients": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "ccRecipients": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "bccRecipients": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "plaintextBody": {
                "type": "string"
              },
              "htmlBody": {
                "type": "string"
              },
              "date": {
                "type": "string"
              },
              "humanEdited": {
                "type": "boolean"
              }
            },
            "required": [
              "id",
              "threadId",
              "toRecipients",
              "date"
            ]
          }
        },
        "nextPageToken": {
          "type": "string"
        }
      },
      "required": [
        "drafts"
      ]
    }
  },
  {
    "name": "create_draft",
    "description": "Creates a draft email for a person to review and send. To reply in an existing thread pass the original message's ID as replyToMessageId. Addresses are plain (no 'Name <email>'). Attachments are not supported yet. Nothing is sent.",
    "parameters": {
      "type": "object",
      "properties": {
        "to": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Recipient email addresses."
        },
        "cc": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "bcc": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "subject": {
          "type": "string"
        },
        "body": {
          "type": "string",
          "description": "Plain-text body."
        },
        "htmlBody": {
          "type": "string"
        },
        "replyToMessageId": {
          "type": "string",
          "description": "The message this draft replies to; the draft joins its thread."
        },
        "attachments": {
          "type": "array",
          "items": {
            "type": "object"
          }
        }
      }
    },
    "mutates_state": true,
    "returns": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "subject": {
          "type": "string"
        },
        "threadId": {
          "type": "string"
        },
        "toRecipients": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "ccRecipients": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "bccRecipients": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "plaintextBody": {
          "type": "string"
        },
        "htmlBody": {
          "type": "string"
        },
        "date": {
          "type": "string"
        },
        "humanEdited": {
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "threadId",
        "toRecipients",
        "date"
      ]
    }
  }
]
