        "snippet",
        "label_ids",
        "messages"
      ],
      "properties": {
        "label_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "messages": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "sender": {
                "type": "string"
              },
              "cc": {
                "type": "string"
              },
              "id": {
                "type": "string"
              },
              "thread_id": {
                "type": "string"
              },
              "date": {
                "type": "string"
              },
              "recipient": {
                "type": "string"
              },
              "subject": {
                "type": "string"
              },
              "snippet": {
                "type": "string"
              },
              "body": {
                "type": "string"
              }
            },
            "required": [
              "id",
              "thread_id",
              "sender",
              "recipient",
              "subject",
              "body",
              "date"
            ]
          }
        },
        "id": {
          "type": "string"
        },
        "snippet": {
          "type": "string"
        },
        "history_id": {
          "type": "string"
        }
      },
      "type": "object"
    }
  },
  {
    "name": "get_message",
