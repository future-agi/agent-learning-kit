  {
    "name": "label_thread",
    "description": "Add or remove labels from an email thread.",
    "parameters": {
      "type": "object",
      "properties": {
        "thread_id": {
          "type": "string",
          "description": "ID of the thread to label"
        },
        "remove_label_ids": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "List of label IDs to remove from the thread"
        },
        "add_label_ids": {
          "items": {
            "type": "string"
          },
          "type": "array",
          "description": "List of label IDs to add to the thread"
        }
      },
      "required": [
        "thread_id"
      ]
    },
    "mutates_state": true,
    "returns": {
      "required": [
        "thread_id",
        "label_ids"
      ],
      "properties": {
        "label_ids": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "thread_id": {
          "type": "string"
        }
      },
      "type": "object"
    }
  },
