      "type": "object",
      "properties": {
        "messageId": {
          "type": "string",
          "description": "The unique identifier of the message."
        },
        "messageFormat": {
          "type": "string",
          "description": "MESSAGE_FORMAT_UNSPECIFIED, MINIMAL, FULL_CONTENT (default; bodies included) or METADATA_ONLY."
        }
      },
      "required": [
        "messageId"
      ]
    },
    "mutates_state": false,
    "returns": {
      "type": "object",
