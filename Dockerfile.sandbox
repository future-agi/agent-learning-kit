FROM docker:27-cli AS docker-cli
FROM ghcr.io/astral-sh/uv:latest AS uvbin

FROM python:3.12-slim-bookworm

COPY --from=docker-cli /usr/local/bin/docker /usr/local/bin/docker
COPY --from=docker-cli /usr/local/libexec/docker/cli-plugins/docker-compose /usr/local/libexec/docker/cli-plugins/docker-compose
COPY --from=uvbin /uv /uvx /usr/local/bin/

RUN apt-get update \
    && apt-get install -y --no-install-recommends build-essential git libffi-dev nodejs npm postgresql-15 redis-server \
    && npm install --global @anthropic-ai/claude-code \
    && ln -s /usr/lib/postgresql/15/bin/initdb /usr/local/bin/initdb \
    && ln -s /usr/lib/postgresql/15/bin/postgres /usr/local/bin/postgres \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# Match the hosted process-isolation identities. PostgreSQL refuses to initialize as root, and
# local certification must exercise the same privilege boundaries as Daytona.
RUN groupadd --gid 2000 svc-control \
    && useradd --uid 2000 --gid 2000 --create-home --shell /bin/bash svc-control \
    && groupadd --gid 2001 svc-agent \
    && useradd --uid 2001 --gid 2001 --create-home --shell /usr/sbin/nologin svc-agent \
    && groupadd --gid 2002 svc-tools \
    && useradd --uid 2002 --gid 2002 --create-home --shell /usr/sbin/nologin svc-tools \
    && groupadd --gid 2003 svc-data \
    && useradd --uid 2003 --gid 2003 --create-home --shell /usr/sbin/nologin svc-data

WORKDIR /opt/alk
COPY pyproject.toml README.md ./
COPY src ./src
ENV PIP_DEFAULT_TIMEOUT=300 \
    PIP_RETRIES=10 \
    PIP_DISABLE_PIP_VERSION_CHECK=1
RUN --mount=type=cache,target=/root/.cache/pip \
    python3 -m pip install \
      '.[livekit,harness-ui,harness-stores]' \
      'livekit-agents==1.5.17' \
      'livekit-plugins-cartesia==1.5.17' \
      'livekit-plugins-deepgram==1.5.17' \
      'livekit-plugins-elevenlabs==1.5.17' \
      'livekit-plugins-google==1.5.17' \
      'livekit-plugins-openai==1.5.17' \
      'livekit-plugins-silero==1.5.17'

ENV ALK_SANDBOX_HOST=0.0.0.0
ENV ALK_SANDBOX_PORT=8788
EXPOSE 8788
ENTRYPOINT ["python3", "-m", "fi.alk.harness.sandbox_server"]
