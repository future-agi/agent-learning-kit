{
  "schema_version": "futureagi.sse-transport-reference.v1",
  "id": "ag-ui-crewai-backend-tool-rendering",
  "framework": {
    "name": "ag_ui_crewai",
    "version": "1.0.0"
  },
  "source": {
    "repository": "https://github.com/ag-ui-protocol/ag-ui.git",
    "commit": "2b967c34c49759c4afe0f0a176b281a0f645de34",
    "subdirectory": "integrations/crew-ai/python",
    "license": "MIT"
  },
  "source_checks": [
    {
      "path": "examples/agents/dojo.py",
      "contains": "path=f\"/conversational_flows/{feature}\""
    },
    {
      "path": "examples/agents/conversational.py",
      "contains": "\"backend_tool_rendering\": _conversational_type(BackendToolRenderingFlow)"
    },
    {
      "path": "examples/agents/backend_tool_rendering.py",
      "contains": "@tool(\"get_weather\")"
    },
    {
      "path": "examples/agents/_crewai_llm.py",
      "contains": "_MODEL_ENV_VARS = (\"MODEL\", \"MODEL_NAME\", \"OPENAI_MODEL_NAME\")"
    },
    {
      "path": "ag_ui_crewai/_frames.py",
      "contains": "type=EventType.RUN_FINISHED"
    }
  ],
  "runtime": {
    "working_directory": "examples",
    "command": ["uv", "run", "dev"],
    "environment": {
      "MODEL": "vertex_ai/gemini-3.7-flash",
      "VERTEXAI_LOCATION": "global"
    },
    "environment_names": ["GOOGLE_APPLICATION_CREDENTIALS", "VERTEXAI_PROJECT"],
    "authentication": "google_application_credentials_file",
    "supplemental_dependencies": ["google-auth"],
    "endpoint": "/conversational_flows/backend_tool_rendering"
  },
  "request": {
    "threadId": "{{thread_id}}",
    "runId": "{{execution_id}}-{{turn_index}}",
    "state": {},
    "messages": [
      {
        "id": "user-{{execution_id}}-{{turn_index}}",
        "role": "user",
        "content": "{{new_message_content}}"
      }
    ],
    "tools": [],
    "context": [],
    "forwardedProps": {}
  },
  "sse": {
    "completion": {"path": "data.type", "values": ["RUN_FINISHED"]},
    "failure": {"path": "data.type", "values": ["RUN_ERROR"]},
    "text": [
      {
        "mode": "cumulative",
        "path": "data.messages.-1.content",
        "when": {"path": "data.messages.-1.role", "values": ["assistant"]}
      }
    ]
  },
  "qualification": {
    "requires_credentials": true,
    "turns": [
      "Ask for the weather in Pune and require the source get_weather tool.",
      "In the same threadId, ask which city was checked and what condition it reported."
    ],
    "required_evidence": [
      "both turns end with RUN_FINISHED and no RUN_ERROR",
      "the last assistant content in MESSAGES_SNAPSHOT becomes the answer for each turn",
      "the second answer depends on the first turn under the same threadId",
      "get_weather executes exactly once and its source-owned result is retained",
      "client cancellation closes the SSE connection",
      "explicit completion returns without waiting for response EOF"
    ],
    "tool_event_status": "pending",
    "tool_event_gap": "The live Vertex run observed exactly one get_weather TOOL_CALL_START followed by TOOL_CALL_ARGS, TOOL_CALL_END, and TOOL_CALL_RESULT. ALK's current generic completed-tool collectors require complete action/result objects, so normalized tool-evidence qualification remains pending until a declarative mapping can pair those fragments without framework-specific execution semantics."
  }
}
