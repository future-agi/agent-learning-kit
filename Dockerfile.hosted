FROM node:20-bookworm-slim AS node20
FROM node:22-bookworm-slim AS node22
FROM python:3.11-slim-bookworm AS python311
FROM rabbitmq:3.13.7-management AS rabbitmq313

FROM ubuntu:24.04

ARG DEBIAN_FRONTEND=noninteractive

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
      ca-certificates curl ffmpeg git gnupg iptables libcap2-bin \
      postgresql-16 procps python3-pip python3.12 python3.12-venv \
      redis-server slirp4netns socat uidmap xz-utils \
    && rm -rf /var/lib/apt/lists/*

COPY --from=node20 /usr/local/bin/node /opt/node20/bin/node
COPY --from=node20 /usr/local/lib/node_modules/npm /opt/node20/lib/node_modules/npm
COPY --from=node22 /usr/local/bin/node /opt/node22/bin/node
COPY --from=node22 /usr/local/lib/node_modules/npm /opt/node22/lib/node_modules/npm
COPY --from=python311 /usr/local /opt/python311
COPY --from=rabbitmq313 /opt/rabbitmq /opt/rabbitmq
RUN rm -f /opt/rabbitmq/etc/rabbitmq/enabled_plugins /etc/rabbitmq/enabled_plugins || true
COPY --from=rabbitmq313 /opt/erlang /opt/erlang

RUN python3.12 -m venv /opt/alk-venv \
    && ln -s /opt/node22/bin/node /usr/local/bin/node \
    && printf '#!/bin/sh\nexec /opt/node20/bin/node /opt/node20/lib/node_modules/npm/bin/npm-cli.js "$@"\n' > /usr/local/bin/npm20 \
    && printf '#!/bin/sh\nexec /opt/node22/bin/node /opt/node22/lib/node_modules/npm/bin/npm-cli.js "$@"\n' > /usr/local/bin/npm22 \
    && ln -s /opt/node20/bin/node /usr/local/bin/node20 \
    && ln -s /opt/node22/bin/node /usr/local/bin/node22 \
    && ln -s /opt/python311/bin/python3.11 /usr/local/bin/python3.11 \
    && ln -s /usr/lib/postgresql/16/bin/postgres /usr/local/bin/postgres \
    && ln -s /usr/lib/postgresql/16/bin/initdb /usr/local/bin/initdb \
    && printf '#!/bin/sh\nexec /opt/rabbitmq/sbin/rabbitmq-server "$@"\n' > /usr/local/bin/rabbitmq-server \
    && printf '#!/bin/sh\nexec /opt/rabbitmq/sbin/rabbitmqctl "$@"\n' > /usr/local/bin/rabbitmqctl \
    && chmod 0755 /usr/local/bin/npm20 /usr/local/bin/npm22 /usr/local/bin/rabbitmq-server /usr/local/bin/rabbitmqctl

RUN groupadd --gid 2000 svc-control \
    && useradd --uid 2000 --gid 2000 --create-home --shell /bin/bash svc-control \
    && groupadd --gid 2001 svc-agent \
    && useradd --uid 2001 --gid 2001 --create-home --shell /usr/sbin/nologin svc-agent \
    && groupadd --gid 2002 svc-tools \
    && useradd --uid 2002 --gid 2002 --create-home --shell /usr/sbin/nologin svc-tools \
    && groupadd --gid 2003 svc-data \
    && useradd --uid 2003 --gid 2003 --create-home --shell /usr/sbin/nologin svc-data \
    && echo 'svc-control:100000:65536' >> /etc/subuid \
    && echo 'svc-control:100000:65536' >> /etc/subgid \
    && install -d -o svc-control -g svc-control -m 0755 /work /work/artifacts \
    && install -d -o svc-control -g svc-control -m 0700 /run/futureagi /run/user/2000 \
    && install -d -o root -g root -m 0755 /opt/alk

WORKDIR /opt/alk
COPY pyproject.toml README.md ./
COPY src ./src
COPY hosted-snapshot/catalog.json /opt/alk/hosted-snapshot-catalog.json

ENV PIP_DEFAULT_TIMEOUT=300 \
    PIP_RETRIES=10 \
    PIP_DISABLE_PIP_VERSION_CHECK=1
RUN --mount=type=cache,target=/root/.cache/pip \
    /opt/alk-venv/bin/pip install '.[livekit,harness-ui,harness-stores]' \
    && chmod -R a-w /opt/alk /opt/alk-venv

ENV PATH="/opt/alk-venv/bin:/usr/lib/postgresql/16/bin:/opt/erlang/bin:/opt/rabbitmq/sbin:/opt/node22/bin:${PATH}" \
    PYTHONDONTWRITEBYTECODE=1 \
    XDG_RUNTIME_DIR=/run/user/2000

USER svc-control
WORKDIR /work
CMD ["sleep", "infinity"]
